# Keep the build context small. Unfiltered this directory is ~4.7 GB, nearly
# all of it native build output that the web image has no use for, and every
# byte of it would be uploaded to the daemon on each build.
#
# Native SOURCE (android/app/src, ios/RecommendMeApp) is deliberately kept, so
# an Android build stage could be added to the Dockerfile without reworking
# this file. Only generated trees are excluded.

# Dependencies: reinstalled inside the image with `npm ci` against the lockfile.
# The host's tree is built for the host's OS and must never leak in.
node_modules
vendor/bundle
vendor

# Native build output (~2.4 GB combined)
android/app/build
android/build
android/.gradle
android/.kotlin
android/local.properties
ios/Pods
ios/build
ios/DerivedData
*.xcworkspace/xcuserdata
*.xcodeproj/xcuserdata

# Web build output: regenerated by webpack, and a stale copy in the image is
# worse than none.
dist

# VCS and repo tooling
.git
.gitignore
.gitattributes
.claude
claude

# Docker's own files
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Editors and OS cruft
.idea
.vscode
*.iml
.DS_Store
**/.DS_Store

# Local secrets and logs -- must not be baked into an image layer
.env
.env.*
*.log
npm-debug.log*
yarn-error.log*

# Test/coverage artefacts
coverage
.jest-cache

# Build output copied out of the Android container
dist-apk
